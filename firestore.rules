rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin(uid) {
      return exists(/databases/$(database)/documents/admins/$(uid));
    }

    match /settings/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin(request.auth.uid);
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && isAdmin(request.auth.uid);
      allow update: if request.auth != null && isAdmin(request.auth.uid);
      allow delete: if request.auth != null && isAdmin(request.auth.uid);
    }

    match /tickets/{ticketId} {
      allow read: if request.auth != null && (
        isAdmin(request.auth.uid) ||
        resource.data.ownerUid == request.auth.uid
      );

      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ticketNumber is number
        && request.resource.data.status == 'WAITING'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.calledAt == null
        && request.resource.data.startedAt == null
        && request.resource.data.completedAt == null;

      allow update: if request.auth != null && isAdmin(request.auth.uid);
      allow delete: if request.auth != null && isAdmin(request.auth.uid);
    }
  }
}
